{
  "uid": "codex-tailnet",
  "title": "Codex / Personal PC",
  "tags": ["codex", "tailscale", "otel"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "text", "title": "Codex telemetry",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {"mode": "markdown", "content": "개인 PC의 Codex 사용 이후 데이터가 표시됩니다. 요청·도구 메트릭과 로그를 확인하고, 트레이스는 Explore → **AI Traces**에서 조회하세요. Collector가 UP이어도 PC 데이터 수신을 의미하지는 않습니다. 비용/토큰은 수신 데이터로 확인되기 전까지 추정하지 않습니다."}
    },
    {
      "id": 2, "type": "stat", "title": "Collector scrape 상태",
      "gridPos": {"x": 0, "y": 3, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"ai_telemetry\"}", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "API 요청 / 선택 기간",
      "gridPos": {"x": 6, "y": 3, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(codex_api_request[$__range]))", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}
    },
    {
      "id": 4, "type": "stat", "title": "도구 호출 / 선택 기간",
      "gridPos": {"x": 12, "y": 3, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(codex_tool_call[$__range]))", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}
    },
    {
      "id": 5, "type": "stat", "title": "API 실패 / 선택 기간",
      "gridPos": {"x": 18, "y": 3, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(codex_api_request{success=\"false\"}[$__range]))", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "모델별 API 요청 / 초",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (model) (rate(codex_api_request[$__rate_interval]))", "legendFormat": "{{model}}"}]
    },
    {
      "id": 7, "type": "timeseries", "title": "API 응답 시간 p95",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(codex_api_request_duration_ms_bucket[$__rate_interval])))", "legendFormat": "{{model}}"}],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "도구별 호출 / 초",
      "gridPos": {"x": 0, "y": 15, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (tool) (rate(codex_tool_call[$__rate_interval]))", "legendFormat": "{{tool}}"}]
    },
    {
      "id": 9, "type": "timeseries", "title": "도구 실행 시간 p95",
      "gridPos": {"x": 12, "y": 15, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(codex_tool_call_duration_ms_bucket[$__rate_interval])))", "legendFormat": "{{tool}}"}],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },
    {
      "id": 10, "type": "logs", "title": "Codex 이벤트",
      "gridPos": {"x": 0, "y": 23, "w": 24, "h": 10},
      "datasource": {"type": "loki", "uid": "ai-loki"},
      "targets": [{"refId": "A", "expr": "{service_name=~\"codex.*\"}", "queryType": "range"}],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}
    },
    {
      "id": 11, "type": "table", "title": "수신된 Codex 원시 메트릭",
      "gridPos": {"x": 0, "y": 33, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "{__name__=~\"codex_.+\"}", "instant": true, "format": "table"}]
    }
  ]
}
