# 외부 reverse proxy를 통해 브라우저가 실제로 접근하는 주소입니다. 마지막 /를 포함합니다.
GRAFANA_PUBLIC_URL=https://grafana.example.com/

# authentik의 Grafana OAuth2/OpenID Provider에서 발급한 값입니다.
# authentik 기본 URL: 마지막 / 없이 입력합니다.
GRAFANA_OAUTH_BASE_URL=https://sso.example.com
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
GRAFANA_OAUTH_APP_SLUG=grafana

# SSO 장애 시 로컬 관리자 복구에 사용할 별도 비밀번호입니다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# reverse proxy만 접근하도록 기본적으로 loopback에 게시합니다.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_COOKIE_SECURE=true

# Prometheus가 로컬 시계열 데이터를 보관하는 기간입니다.
PROMETHEUS_RETENTION=30d

# 직접 docker compose를 실행할 때 서버의 Tailscale IPv4를 입력합니다.
# scripts/start-telemetry.py는 이 값을 자동으로 구합니다.
OTEL_TAILSCALE_IP=

# Prometheus에서 접근 가능한 exporter의 host:port (scheme/경로 제외).
ICPM_METRICS_TARGET=exporter.example.com:9090
PCPM_METRICS_TARGET=exporter.example.com:9091
